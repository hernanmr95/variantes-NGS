/*
 * Perfil de test: ejecuta el pipeline completo con datos sintéticos
 * pequeños incluidos en el repositorio, para validar que el flujo
 * funciona de punta a punta en pocos minutos y sin descargas externas.
 */

params {
    input  = "${projectDir}/assets/test_data/samplesheet_test.csv"
    genome = "${projectDir}/assets/test_data/ref_toy.fa"

    max_cpus   = 2
    max_memory = '4.GB'
    max_time   = '1.h'
}

process {
    cpus   = 1
    memory = 1.GB
    time   = 15.min

    // Techo duro de recursos: sin esto, las etiquetas 'low'/'medium'/'high'
    // de conf/base.config (pensadas para HPC real) piden más CPU/memoria
    // de la que tiene un runner de CI (p. ej. BWA_MEM con label 'high'
    // pide 8 CPUs; GitHub Actions solo ofrece 4). resourceLimits recorta
    // automáticamente cualquier solicitud por encima de este máximo, sin
    // tener que sobreescribir cada label a mano.
    resourceLimits = [
        cpus: 2,
        memory: 4.GB,
        time: 1.h
    ]
}
