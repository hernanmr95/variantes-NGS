/*
 * Perfil orientado a ejecución en un clúster SLURM.
 * Ajustar 'queue' y 'clusterOptions' al entorno real antes de usar.
 */

process {
    executor = 'slurm'
    queue    = 'normal'

    withLabel: 'high' {
        queue = 'bigmem'
    }
}

executor {
    queueSize    = 50
    submitRateLimit = '10/1min'
}
