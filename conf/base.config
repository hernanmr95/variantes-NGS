/*
 * Configuración base de recursos por proceso.
 * Las etiquetas (labels) se usan para asignar recursos según la exigencia
 * de cada paso del pipeline.
 */

process {
    cpus   = { 2    * task.attempt }
    memory = { 4.GB * task.attempt }
    time   = { 4.h  * task.attempt }

    errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    withLabel: 'low' {
        cpus   = { 1 * task.attempt }
        memory = { 2.GB * task.attempt }
    }

    withLabel: 'medium' {
        cpus   = { 4 * task.attempt }
        memory = { 8.GB * task.attempt }
    }

    withLabel: 'high' {
        cpus   = { 8  * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 12.h * task.attempt }
    }
}
